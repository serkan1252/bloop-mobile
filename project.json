{
  "name": "BLOOP",
  "options": {
    "deploymentTarget": {
      "iOS": "15.0"
    },
    "createIntermediateGroups": true
  },
  "targets": {
    "BLOOP": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        {
          "path": "BLOOP",
          "excludes": [
            "Game",
            "Info.plist"
          ]
        },
        {
          "path": "BLOOP/Game",
          "type": "folder",
          "buildPhase": "resources"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.bloop.dreamgardens",
          "INFOPLIST_FILE": "BLOOP/Info.plist",
          "GENERATE_INFOPLIST_FILE": "NO",
          "SWIFT_VERSION": "5.0",
          "TARGETED_DEVICE_FAMILY": "1,2",
          "MARKETING_VERSION": "1.0.0",
          "CURRENT_PROJECT_VERSION": "1",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "CODE_SIGN_STYLE": "Automatic"
        }
      }
    }
  },
  "schemes": {
    "BLOOP": {
      "build": {
        "targets": {
          "BLOOP": "all"
        }
      },
      "run": {
        "config": "Debug"
      },
      "archive": {
        "config": "Release"
      }
    }
  }
}
